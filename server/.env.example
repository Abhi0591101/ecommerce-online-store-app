# HyperLocal Grocery API — copy to server/.env and fill in values
# cp .env.example .env

# HTTP port for Express + Socket.IO
PORT=5000

# MongoDB connection string (local or Atlas)
# Local:  mongodb://localhost:27017/hyperlocal_grocery
# Atlas:  mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/hyperlocal_grocery
MONGODB_URI=mongodb://localhost:27017/hyperlocal_grocery

# JWT signing secret — use a long random string in production
JWT_SECRET=your_jwt_secret_key_here

# Allowed browser origin for CORS (Vite dev server or your deployed frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# development | production
# In production, Express also serves ../client/dist if it exists
NODE_ENV=production

# OTP delivery until SMS gateway is live
# demo = fixed DEMO_OTP for all panels (default 123456)
# sms  = random OTP via gateway (server/utils/otpStore.js)
OTP_MODE=demo
DEMO_OTP=123456

# Optional: Google Geocoding API key for accurate GPS → address/pincode
# (same quality as Google Maps). Without it, India Post official geo data is used.
# GOOGLE_MAPS_API_KEY=

# Email queue (franchise confirmation + Head Office alerts)
# Run: npm run emails:send   (from repo root)  OR  npm run emails:send --prefix server
ADMIN_EMAIL=abhishekdb13@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=abhishekdb13@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM="Japto.in <abhishekdb13@gmail.com>"

# Razorpay: configure in Admin Panel → Settings (saved in MongoDB SiteSettings).
# Do not put Key Id / Secret in .env.
