# HyperLocal Grocery Client — copy to client/.env and fill in values
# cp .env.example .env

# REST API base (no trailing slash beyond /api)
VITE_API_URL=http://localhost:5000/api

# Socket.IO server origin (same host as API in most setups)
VITE_SOCKET_URL=http://localhost:5000

# Production examples:
# VITE_API_URL=https://your-api.onrender.com/api
# VITE_SOCKET_URL=https://your-api.onrender.com
